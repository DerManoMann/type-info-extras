parameters:
    phpVersion: 80200
    level: 5
    paths:
        - src
        - tests
    parallel:
        processTimeout: 300.0
    excludePaths:
        - 'tests/Fixtures/*'
    treatPhpDocTypesAsCertain: false
    ignoreErrors:
        -
            # `Type::objectShape()` exists from symfony/type-info 8.1 on
            identifier: function.alreadyNarrowedType
            message: '#^Call to function method_exists\(\) with ''Radebatz\\\\TypeInfoExtras\\\\Type\\\\Type'' and ''objectShape'' will always evaluate to true\.$#'
            path: src/TypeResolver/StringTypeResolver.php
            reportUnmatched: false
        -
            # `GenericTypeNode::$type` is typed `IdentifierTypeNode` before phpstan/phpdoc-parser 2.4
            identifier: instanceof.alwaysTrue
            message: '#^Instanceof between PHPStan\\PhpDocParser\\Ast\\Type\\IdentifierTypeNode and PHPStan\\PhpDocParser\\Ast\\Type\\IdentifierTypeNode will always evaluate to true\.$#'
            path: src/TypeResolver/StringTypeResolver.php
            reportUnmatched: false
        -
            # the same, for the keyword read from it
            identifier: notIdentical.alwaysTrue
            message: '#^Strict comparison using \!\=\= between null and string will always evaluate to true\.$#'
            path: src/TypeResolver/StringTypeResolver.php
            reportUnmatched: false
        -
            # `ArrayShapeType` takes `$isList` from symfony/symfony#67933 on, called only where it does
            identifier: arguments.count
            message: '#^Class Symfony\\Component\\TypeInfo\\Type\\ArrayShapeType constructor invoked with 4 parameters, 1\-3 required\.$#'
            path: src/TypeResolver/StringTypeResolver.php
            reportUnmatched: false
        -
            # `TypeContext::$inheritedTemplateTypes` exists from symfony/symfony@724a5333f0 on, read through `??`
            identifier: property.notFound
            message: '#^Access to an undefined property Symfony\\Component\\TypeInfo\\TypeContext\\TypeContext\:\:\$inheritedTemplateTypes\.$#'
            path: src/TypeResolver/StringTypeResolver.php
            reportUnmatched: false
